{
  "name": "atlas-ai-private",
  "main": "index.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HISTORY",
        "class_name": "AtlasHistory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "atlas-history-v1",
      "new_sqlite_classes": [
        "AtlasHistory"
      ]
    }
  ]
}

